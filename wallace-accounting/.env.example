# App
NODE_ENV=production
PORT=3000
VITE_APP_ID=
OWNER_OPEN_ID=
JWT_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=mysql://user:password@host:3306/wallace_accounting

# Local Docker Compose MySQL. If you use DigitalOcean Managed MySQL, leave
# these unset and use the managed DATABASE_URL above instead.
MYSQL_DATABASE=wallace_accounting
MYSQL_USER=wallace
MYSQL_PASSWORD=replace-with-a-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# OAuth
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# File storage proxy
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional analytics placeholders used by client/index.html
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
